# ---- AI (Composer + Coach Bob) --------------------------------------------
# Without this the UI still runs; AI calls return a friendly "not connected" note.
ANTHROPIC_API_KEY=
# Optional model override:
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Accounts (NextAuth + Resend + Upstash/Vercel KV) ---------------------
# Random secret that signs login tokens: `openssl rand -base64 33`
AUTH_SECRET=
# Resend API key (magic-link emails). Starts with re_
RESEND_API_KEY=
# Sender address. onboarding@resend.dev works but only emails your own account;
# set a Resend-verified domain sender for real users.
# EMAIL_FROM=coach@yourdomain.com

# Upstash Redis / Vercel KV — auto-added when you connect the KV store in Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=
